  "command_contract": {
    "lifecycle": "logical request -> atomic elastic physical command -> asynchronous LUTRAM -> owner-qualified response capture",
    "atomicity": "one command valid/ready/fire and one owner/metadata bundle; primary-V carries four bank lanes, LFNST carries one bank lane",
    "elasticity": "rd_cmd_ready = !rd_cmd_valid_q || owner_response_ready; same-edge retire and refill is allowed",
    "address_source": "input_rd_addr[slot][bank] is unconditionally driven by rd_cmd_addr_q[slot][bank]; invalidity is represented by valid metadata, not an address mux",
    "response_alignment": "primary-V and LFNST response capture consume rd_cmd_slot_q/rd_cmd_* metadata, never live request counters",
    "counter_rule": "primary and LFNST logical counters advance only on logical request acceptance",
    "owner_exclusion": "LFNST candidate has priority over primary-V candidate; command ownership is mutually exclusive",
    "throughput": {
      "request_ii": 1,
      "primary_v_steady_state": "one four-bank command per cycle",
      "lfnst_steady_state": "one one-bank command per cycle"
    }
  },
